pkgbase = hyprpresent
	pkgdesc = Windows-style projector modes (Win+P) for Hyprland: Duplicate without stretching, Extend, Match the TV
	pkgver = 1.0.0
	pkgrel = 1
	url = https://github.com/akashanil-dev/hyprpresent
	arch = any
	license = MIT
	depends = hyprland>=0.55.0
	depends = bash
	depends = jq
	depends = socat
	depends = util-linux
	depends = wl-mirror
	optdepends = fuzzel: picker menu (or walker, wofi, rofi, tofi, bemenu, wmenu)
	optdepends = swaybg: the card shown in Laptop screen only
	optdepends = librsvg: text and QR code on the card
	optdepends = qrencode: QR code on the card
	optdepends = libpulse: switching the sound output
	optdepends = ddcutil: brightness of monitors that take DDC/CI
	optdepends = libnotify: notifications
	optdepends = waybar: showing the mode in the bar
